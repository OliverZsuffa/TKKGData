{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oliverzsuffa.github.io/TKKGData/schemas/episode.schema.json",
  "title": "TKKG main series episode",
  "type": "object",
  "required": [
    "number",
    "title",
    "series",
    "synopsis",
    "cover_url",
    "release_date",
    "release_year",
    "physical_releases",
    "tracks",
    "cast",
    "credits",
    "ratings",
    "sources",
    "last_checked",
    "listening_links"
  ],
  "properties": {
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "series": {
      "const": "TKKG"
    },
    "synopsis": {
      "type": [
        "string",
        "null"
      ]
    },
    "cover_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "release_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "release_year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1900,
      "maximum": 2100
    },
    "physical_releases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "medium": {
            "type": [
              "string",
              "null"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "ean": {
            "type": [
              "string",
              "null"
            ]
          },
          "release_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "source_url"
        ],
        "additionalProperties": false
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "duration": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "character": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "credits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "name"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "ratings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "category",
          "value"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          },
          "review_count": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url",
          "retrieved_at"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "last_checked": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "listening_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "service",
          "label",
          "url",
          "link_type",
          "source_url"
        ],
        "properties": {
          "service": {
            "const": "official"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "(?i)^https://tkkg\\.lnk\\.to/[^\\s]+$"
          },
          "link_type": {
            "const": "official_hub"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    },
    "audio_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "spotify",
        "youtube_music",
        "verification"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "spotify": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "album",
            "tracks",
            "track_count"
          ],
          "properties": {
            "album": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "album_id",
                "url",
                "title",
                "track_count",
                "source_query"
              ],
              "properties": {
                "album_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]{22}$"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://open\\\\.spotify\\\\.com/album/[A-Za-z0-9]{22}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "track_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "source_query": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "tracks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "track_number",
                  "track_id",
                  "url",
                  "title"
                ],
                "properties": {
                  "track_number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "disc_number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "track_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9]{22}$"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://open\\\\.spotify\\\\.com/track/[A-Za-z0-9]{22}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "duration_seconds": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "artist_names": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "track_count": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "youtube_music": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "album",
            "playlist",
            "tracks",
            "track_count"
          ],
          "properties": {
            "album": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "browse_id",
                "url",
                "title",
                "track_count"
              ],
              "properties": {
                "browse_id": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://music\\\\.youtube\\\\.com/browse/"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "artist_names": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "track_count": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "playlist": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "playlist_id",
                "url",
                "title",
                "track_count"
              ],
              "properties": {
                "playlist_id": {
                  "type": "string",
                  "pattern": "^(OLAK5uy_[A-Za-z0-9_-]+|PL[A-Za-z0-9_-]+)$"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://music\\\\.youtube\\\\.com/playlist\\\\?list="
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "track_count": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "tracks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "track_number",
                  "video_id",
                  "url",
                  "title",
                  "artists"
                ],
                "properties": {
                  "track_number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "video_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{11}$"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://music\\\\.youtube\\\\.com/watch\\\\?v=[A-Za-z0-9_-]{11}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "artists": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "album": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "duration_seconds": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "match_score": {
                    "type": "integer"
                  },
                  "match_evidence": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "legacy_pairing": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "spotify_track_id",
                      "spotify_track_url",
                      "spotify_title"
                    ],
                    "properties": {
                      "spotify_track_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9]{22}$"
                      },
                      "spotify_track_url": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https://open\\\\.spotify\\\\.com/track/[A-Za-z0-9]{22}$"
                      },
                      "spotify_title": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            },
            "track_count": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "verified_at",
            "method",
            "spotify",
            "youtube_music"
          ],
          "properties": {
            "status": {
              "enum": [
                "verified",
                "partial",
                "unverified"
              ]
            },
            "verified_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "spotify": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "verified_track_count"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "verified",
                    "unverified",
                    "pending"
                  ]
                },
                "verified_track_count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "youtube_music": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "verified_track_count"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "verified",
                    "unverified",
                    "pending"
                  ]
                },
                "verified_track_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "playlist_status": {
                  "enum": [
                    "verified",
                    "unavailable"
                  ]
                },
                "playlist_error": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "migration": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_schema_version",
                "migrated_at",
                "source_verification"
              ],
              "properties": {
                "source_schema_version": {
                  "const": 1
                },
                "migrated_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "source_verification": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "verified_at",
                    "method",
                    "matched_track_count"
                  ],
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "verified_at": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "method": {
                      "type": "string"
                    },
                    "matched_track_count": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "playlist_status": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "playlist_error": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "alternate_titles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "audio_discovery": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "spotify": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "preferred_album_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{22}$"
            },
            "release_profile": {
              "enum": [
                "standard",
                "two_disc_duplicated_numbering",
                "extended_numbered",
                "structured_extras",
                "shared_title_song"
              ]
            },
            "expected_story_parts": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
